<?xml version="1.0" encoding="UTF-8"?>
<!-- Configuración mínima y endurecida de Tomcat 10.1 -->
<!-- Server port="-1": desactiva el puerto de apagado (SHUTDOWN) -->
<Server port="-1" shutdown="SHUTDOWN">
  <Listener className="org.apache.catalina.startup.VersionLoggerListener" />
  <Listener className="org.apache.catalina.core.JreMemoryLeakPreventionListener" />
  <Listener className="org.apache.catalina.core.ThreadLocalLeakPreventionListener" />

  <Service name="Catalina">
    <!-- Solo HTTP interno: el TLS lo termina Nginx -->
    <Connector port="8080" protocol="HTTP/1.1"
               connectionTimeout="20000"
               maxHttpHeaderSize="8192"
               maxPostSize="1048576"
               xpoweredBy="false" />

    <Engine name="Catalina" defaultHost="localhost">
      <Host name="localhost" appBase="webapps"
            unpackWARs="false" autoDeploy="false">

        <!-- Toma la IP y el esquema reales de las cabeceras que añade Nginx -->
        <Valve className="org.apache.catalina.valves.RemoteIpValve"
               remoteIpHeader="X-Forwarded-For"
               protocolHeader="X-Forwarded-Proto" />

        <!-- Páginas de error sin versión del servidor ni trazas -->
        <Valve className="org.apache.catalina.valves.ErrorReportValve"
               showReport="false" showServerInfo="false" />
      </Host>
    </Engine>
  </Service>
</Server>
