<?xml version="1.0" encoding="UTF-8"?>
<!-- Contexto global de Tomcat: define el datasource JNDI hacia PostgreSQL.
     Los valores ${...} se leen de variables de entorno (ver CATALINA_OPTS en el Dockerfile);
     la contraseña la inyecta entrypoint.sh desde un secreto de Docker, nunca está en el repositorio. -->
<Context>
  <WatchedResource>WEB-INF/web.xml</WatchedResource>
  <WatchedResource>WEB-INF/tomcat-web.xml</WatchedResource>

  <Resource name="jdbc/appdb"
            auth="Container"
            type="javax.sql.DataSource"
            driverClassName="org.postgresql.Driver"
            url="jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}"
            username="${DB_USER}"
            password="${DB_PASSWORD}"
            maxTotal="10"
            maxIdle="5"
            minIdle="1"
            maxWaitMillis="5000"
            validationQuery="SELECT 1"
            testOnBorrow="true"
            connectionProperties="ApplicationName=laboratorio-status;connectTimeout=5;socketTimeout=10" />
</Context>
